# Copy to .dev.vars for local development.
SEARCH1API_API_KEY=
# Enabled decision providers in order of preference: typesafe, vercel, cloudflare, clef, clef-flash, openai.
# Unlisted providers stay off; extra listed ones are fallbacks on 402, 429 and 5xx. Empty means typesafe.
JEV_PROVIDERS=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# The cloudflare, clef and clef-flash providers use the Workers AI binding: no key, just `wrangler login`.
